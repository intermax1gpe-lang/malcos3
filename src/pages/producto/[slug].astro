---
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import { allProducts, getProductBySlug } from '../../data/allProducts';

export function getStaticPaths() {
  return allProducts.map(p => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const product = getProductBySlug(slug);

if (!product) return Astro.redirect('/');

const related = allProducts
  .filter(p => p.brandSlug === product.brandSlug && p.slug !== product.slug)
  .slice(0, 4);

const waMsg = encodeURIComponent(`Hola MALCOS, deseo cotizar:\n• ${product.name} (${product.brand})`);
---

<Layout title={`${product.name} | MALCOS Intercomunicadores`} description={`${product.name} - ${product.brand}. ${product.bullets[0] ?? ''} Distribuidor autorizado en Lima, Perú.`}>
  <TopBar />
  <Navbar />

  <!-- Breadcrumb -->
  <div class="bg-slate-50 border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-6 md:px-12 py-3 flex items-center gap-2 text-xs text-slate-400">
      <a href="/" class="hover:text-brand-blue transition-colors">Inicio</a>
      <span>/</span>
      <a href={`/marca/${product.brandSlug}`} class="hover:text-brand-blue transition-colors">{product.brand}</a>
      <span>/</span>
      <span class="text-slate-600 font-medium">{product.name}</span>
    </div>
  </div>

  <!-- Producto principal -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 py-12 md:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">

      <!-- Imagen -->
      <div class="bg-slate-50 rounded-2xl p-8 flex items-center justify-center border border-slate-100 sticky top-24">
        <img
          src={product.mainImg}
          alt={product.name}
          class="w-full max-w-sm object-contain"
          onerror={`this.src='${product.img}'`}
        />
      </div>

      <!-- Info -->
      <div>
        <!-- Badge marca -->
        <div class="flex items-center gap-3 mb-4">
          <span class="bg-brand-blue/10 text-brand-blue text-[10px] font-extrabold uppercase tracking-widest px-3 py-1 rounded-full">
            {product.brand}
          </span>
          <span class="text-slate-400 text-xs">{product.category}</span>
        </div>

        <h1 class="text-2xl md:text-4xl font-black text-slate-900 leading-tight mb-6">
          {product.name}
        </h1>

        <!-- Specs / bullets -->
        {product.bullets.length > 0 && (
          <div class="mb-8">
            <h2 class="text-xs font-extrabold text-slate-500 uppercase tracking-widest mb-3">Características</h2>
            <ul class="space-y-2">
              {product.bullets.map(b => (
                <li class="flex items-start gap-2.5 text-sm text-slate-700">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-brand-orange flex-shrink-0"></span>
                  {b}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Nota sin precio -->
        <div class="bg-brand-blue/5 border border-brand-blue/15 rounded-xl p-4 mb-8">
          <p class="text-xs text-brand-blue font-semibold">
            💬 Este producto no tiene precio publicado. Contáctanos para recibir una cotización personalizada.
          </p>
        </div>

        <!-- Botones de acción -->
        <div class="flex flex-col sm:flex-row gap-3 mb-6">
          <button
            id="btn-add-cart"
            data-id={product.slug}
            data-name={product.name}
            data-img={product.img}
            data-brand={product.brand}
            data-url={`/producto/${product.slug}`}
            class="flex-1 bg-brand-blue hover:bg-blue-800 text-white font-extrabold text-sm uppercase tracking-widest py-4 px-6 rounded-xl flex items-center justify-center gap-2 transition-colors shadow-md"
          >
            <svg class="w-5 h-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
            Agregar al carrito
          </button>
          <a
            href={`https://wa.me/51934852558?text=${waMsg}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 bg-green-500 hover:bg-green-600 text-white font-extrabold text-sm uppercase tracking-widest py-4 px-6 rounded-xl flex items-center justify-center gap-2 transition-colors shadow-md"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Cotizar ahora
          </a>
        </div>

        <a href={`/marca/${product.brandSlug}`} class="text-xs text-slate-400 hover:text-brand-blue transition-colors underline underline-offset-2">
          ← Ver más productos {product.brand}
        </a>
      </div>
    </div>
  </section>

  <!-- Productos relacionados -->
  {related.length > 0 && (
    <section class="bg-slate-50 py-12 md:py-16 border-t border-slate-100">
      <div class="max-w-7xl mx-auto px-6 md:px-12">
        <h2 class="text-xl font-black text-slate-900 uppercase mb-8">
          Más productos <span class="text-brand-blue">{product.brand}</span>
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
          {related.map(p => (
            <a
              href={`/producto/${p.slug}`}
              class="group bg-white border border-slate-100 rounded-xl p-4 flex flex-col items-center gap-3 hover:shadow-lg hover:border-brand-orange/40 transition-all duration-300"
            >
              <div class="w-full aspect-square flex items-center justify-center bg-slate-50 rounded-lg p-3">
                <img src={p.img} alt={p.name} class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" loading="lazy" />
              </div>
              <p class="text-xs font-semibold text-slate-700 text-center leading-snug group-hover:text-brand-blue transition-colors">{p.name}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer />
  <WhatsAppFloat />
  <CartDrawer />
</Layout>

<script>
  import { addItem } from '../../scripts/cart';

  const btn = document.getElementById('btn-add-cart') as HTMLButtonElement;
  btn?.addEventListener('click', () => {
    addItem({
      id: btn.dataset.id!,
      name: btn.dataset.name!,
      img: btn.dataset.img!,
      brand: btn.dataset.brand!,
      url: btn.dataset.url!,
    });
    const original = btn.innerHTML;
    btn.innerHTML = '✓ Agregado al carrito';
    btn.classList.add('bg-green-600');
    btn.classList.remove('bg-brand-blue', 'hover:bg-blue-800');
    setTimeout(() => {
      btn.innerHTML = original;
      btn.classList.remove('bg-green-600');
      btn.classList.add('bg-brand-blue', 'hover:bg-blue-800');
    }, 1500);
    window.dispatchEvent(new CustomEvent('cart:open'));
  });
</script>
