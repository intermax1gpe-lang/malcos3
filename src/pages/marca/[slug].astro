---
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Navbar from '../../components/Navbar.astro';
import CatalogSection from '../../components/CatalogSection.astro';
import Cotizacion from '../../components/Cotizacion.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import { brands } from '../../data/brands';
import { commaxProducts } from '../../data/commaxProducts';
import { yusphoneProducts } from '../../data/yusphoneProducts';
import { belcomProducts } from '../../data/belcomProducts';
import { hikvisionProducts } from '../../data/hikvisionProducts';
import type { ProductCategory } from '../../data/commaxProducts';

const catalogBySlug: Record<string, { categories: ProductCategory[]; description: string }> = {
  commax: { categories: commaxProducts, description: 'Intercomunicadores, videoporteros y sistemas de audio para casa, oficina y edificio.' },
  yusphone: { categories: yusphoneProducts, description: 'Sistemas de intercomunicación residencial y de edificios con tecnología de punta.' },
  belcom: { categories: belcomProducts, description: 'Porteros y sistemas de intercomunicación para casa y edificios.' },
  hikvision: { categories: hikvisionProducts, description: 'Videoporteros IP, control de acceso y redes para casa y edificio.' },
};

export function getStaticPaths() {
  return brands.map(b => ({ params: { slug: b.slug } }));
}

const { slug } = Astro.params;
const brand = brands.find(b => b.slug === slug);
const catalog = slug ? catalogBySlug[slug] : undefined;

if (!brand || !catalog) return Astro.redirect('/');
---

<Layout
  title={`Catálogo ${brand.name} | MALCOS Intercomunicadores`}
  description={`Catálogo completo ${brand.name}: ${catalog.description} Distribuidor autorizado en Lima, Perú.`}
>
  <TopBar />
  <Navbar />

  <!-- Breadcrumb -->
  <div class="bg-slate-50 border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-6 md:px-12 py-3 flex items-center gap-2 text-xs text-slate-400">
      <a href="/" class="hover:text-brand-blue transition-colors">Inicio</a>
      <span>/</span>
      <span class="text-slate-600 font-medium">{brand.name}</span>
    </div>
  </div>

  <CatalogSection
    id={brand.slug}
    brandName={brand.name}
    logo={brand.logo}
    description={catalog.description}
    categories={catalog.categories}
    bgColor="bg-white"
  />

  <Cotizacion />
  <Footer />
  <WhatsAppFloat />
  <CartDrawer />
</Layout>
