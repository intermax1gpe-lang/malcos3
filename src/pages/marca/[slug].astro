---
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Navbar from '../../components/Navbar.astro';
import CatalogSection from '../../components/CatalogSection.astro';
import Cotizacion from '../../components/Cotizacion.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import { brands } from '../../data/brands';
import { commaxProducts } from '../../data/commaxProducts';
import { yusphoneProducts } from '../../data/yusphoneProducts';
import { belcomProducts } from '../../data/belcomProducts';
import { hikvisionProducts } from '../../data/hikvisionProducts';
import type { ProductCategory } from '../../data/commaxProducts';

const catalogBySlug: Record<string, { categories: ProductCategory[]; description: string; banner: string }> = {
  commax: { categories: commaxProducts, description: 'Intercomunicadores, videoporteros y sistemas de audio para casa, oficina y edificio.', banner: '/images/banners/banner-commax.jpeg' },
  yusphone: { categories: yusphoneProducts, description: 'Sistemas de intercomunicación residencial y de edificios con tecnología de punta.', banner: '/images/banners/banner-yusphone.jpeg' },
  belcom: { categories: belcomProducts, description: 'Porteros y sistemas de intercomunicación para casa y edificios.', banner: '/images/banners/banner-belcom.jpeg' },
  hikvision: { categories: hikvisionProducts, description: 'Videoporteros IP, control de acceso y redes para casa y edificio.', banner: '/images/banners/banner-hikvision.jpeg' },
};

export function getStaticPaths() {
  return brands.map(b => ({ params: { slug: b.slug } }));
}

const { slug } = Astro.params;
const brand = brands.find(b => b.slug === slug);
const catalog = slug ? catalogBySlug[slug] : undefined;

if (!brand || !catalog) return Astro.redirect('/');
---

<Layout
  title={`Catálogo ${brand.name} | MALCOS Intercomunicadores`}
  description={`Catálogo completo ${brand.name}: ${catalog.description} Distribuidor autorizado en Lima, Perú.`}
>
  <TopBar />
  <Navbar />

  <!-- Breadcrumb -->
  <div class="bg-slate-50 border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-6 md:px-12 py-3 flex items-center gap-2 text-xs text-slate-400">
      <a href="/" class="hover:text-brand-blue transition-colors">Inicio</a>
      <span>/</span>
      <span class="text-slate-600 font-medium">{brand.name}</span>
    </div>
  </div>

  <!-- Banner de marca -->
  <section class="relative h-56 md:h-72 overflow-hidden">
    <img src={catalog.banner} alt={`Banner ${brand.name}`} class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-r from-[#0a1437]/85 via-[#0a1437]/50 to-transparent"></div>
    <div class="relative h-full max-w-7xl mx-auto px-6 md:px-12 flex flex-col justify-center">
      <span class="inline-flex self-start bg-white rounded-lg px-4 py-2 shadow-sm mb-4">
        <img src={brand.logo} alt={brand.name} class="h-8 md:h-10 object-contain" />
      </span>
      <h1 class="text-2xl md:text-4xl font-black text-white uppercase leading-tight max-w-lg">
        Catálogo {brand.name}
      </h1>
      <p class="text-slate-200 text-sm md:text-base mt-2 max-w-lg">{catalog.description}</p>
    </div>
  </section>

  <CatalogSection
    id={brand.slug}
    brandName={brand.name}
    logo={brand.logo}
    description={catalog.description}
    categories={catalog.categories}
    bgColor="bg-white"
  />

  <Cotizacion />
  <Footer />
  <WhatsAppFloat />
  <CartDrawer />
</Layout>
