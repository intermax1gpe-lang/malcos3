---
---
<div class="relative bg-white border-b border-slate-200 px-6 md:px-12 py-3 flex justify-center sm:justify-between items-center gap-4">
  <!-- Logo -->
  <a href="/" class="flex-shrink-0">
    <img
      src="/brands/logo-malcos.png"
      alt="MALCOS Intercomunicadores"
      class="h-12 md:h-14 w-auto object-contain"
    />
  </a>

  <!-- Botón carrito (solo mobil, alineado a la altura del logo) -->
  <button
    id="topbar-cart-btn"
    aria-label="Ver cotización"
    class="cart-open-btn sm:hidden absolute right-4 top-1/2 -translate-y-1/2 flex items-center justify-center bg-brand-orange hover:bg-orange-500 transition-colors text-white p-2.5 rounded-lg"
  >
    <svg class="w-5 h-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
    </svg>
    <span data-cart-badge-wrap class="hidden absolute -top-1.5 -right-1.5">
      <span data-cart-badge class="bg-white text-brand-orange text-[10px] font-black rounded-full w-4 h-4 flex items-center justify-center">0</span>
    </span>
  </button>

  <!-- Contactos -->
  <div class="hidden sm:flex flex-col sm:flex-row gap-6 md:gap-8 items-center sm:items-stretch">
    <!-- Teléfono -->
    <a href="tel:+51934852558" class="flex items-center gap-3 hover:opacity-90 transition-opacity">
      <div class="w-9 h-9 rounded-full border-2 border-[#1a4f9c] flex items-center justify-center text-[#1a4f9c] text-sm">
        📞
      </div>
      <div>
        <p class="text-base md:text-lg font-black text-[#1a4f9c] leading-tight">934 852 558</p>
        <p class="text-[10px] text-slate-500 font-semibold uppercase tracking-wider">Llámanos</p>
      </div>
    </a>
    <!-- Email -->
    <a href="mailto:ventas@malcos.com.pe" class="flex items-center gap-3 hover:opacity-90 transition-opacity">
      <div class="w-9 h-9 rounded-full border-2 border-[#1a4f9c] flex items-center justify-center text-[#1a4f9c] text-sm">
        ✉️
      </div>
      <div>
        <p class="font-black text-[#1a4f9c] leading-tight text-sm md:text-base">ventas@malcos.com.pe</p>
        <p class="text-[10px] text-slate-500 font-semibold uppercase tracking-wider">Escríbenos</p>
      </div>
    </a>
  </div>
</div>
