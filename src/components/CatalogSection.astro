---
import type { ProductCategory } from '../data/commaxProducts';

interface Props {
  id: string;
  brandName: string;
  logo: string;
  description: string;
  categories: ProductCategory[];
  bgColor?: string;
}

const { id, brandName, logo, description, categories, bgColor = 'bg-white' } = Astro.props;
const uid = id.replace(/[^a-z0-9]/gi, '');
---

<section id={id} class={`${bgColor} py-16 md:py-24`}>
  <div class="max-w-7xl mx-auto px-6 md:px-12">

    <!-- Cabecera -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
      <div>
        <span class="text-brand-orange text-xs font-extrabold uppercase tracking-widest mb-3 block">Catálogo {brandName}</span>
        <h2 class="text-3xl md:text-4xl font-black text-slate-900 uppercase leading-tight">
          Productos <span class="text-brand-blue">{brandName}</span>
        </h2>
        <p class="text-slate-500 text-sm mt-2 max-w-md">{description}</p>
      </div>
      <img src={logo} alt={brandName} class="h-8 object-contain opacity-80" />
    </div>

    <!-- Tabs -->
    <div class="mb-8 flex flex-wrap gap-2" data-tabs={uid}>
      {categories.map((cat, i) => (
        <button
          data-tab={`${uid}-${cat.slug}`}
          data-group={uid}
          class={`tab-btn px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wide border transition-all duration-200 ${i === 0 ? 'bg-brand-blue text-white border-brand-blue' : 'bg-white text-slate-600 border-slate-200 hover:border-brand-blue hover:text-brand-blue'}`}
        >
          {cat.category}
        </button>
      ))}
    </div>

    <!-- Paneles -->
    {categories.map((cat, i) => (
      <div
        id={`panel-${uid}-${cat.slug}`}
        data-group={uid}
        class={`product-panel grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 md:gap-6 ${i !== 0 ? 'hidden' : ''}`}
      >
        {cat.products.map((p) => {
          const productId = p.url.split('/producto/')[1]?.replace(/\/$/, '') ?? p.name;
          return (
          <div class="group bg-white border border-slate-100 rounded-xl p-4 flex flex-col items-center gap-3 hover:shadow-lg hover:border-brand-orange/40 transition-all duration-300">
            <!-- Imagen -->
            <a href={p.url} target="_blank" rel="noopener noreferrer" class="w-full">
              <div class="w-full aspect-square flex items-center justify-center overflow-hidden rounded-lg bg-slate-50 p-3">
                <img
                  src={p.img}
                  alt={p.name}
                  class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>
            </a>
            <!-- Nombre -->
            <p class="text-xs font-semibold text-slate-700 text-center leading-snug group-hover:text-brand-blue transition-colors flex-1">
              {p.name}
            </p>
            <!-- Botones -->
            <div class="w-full flex flex-col gap-2 mt-1">
              <button
                class="add-to-cart w-full bg-brand-blue hover:bg-blue-800 text-white text-[10px] font-extrabold uppercase tracking-wide py-2 rounded-lg flex items-center justify-center gap-1.5 transition-colors"
                data-id={productId}
                data-name={p.name}
                data-img={p.img}
                data-brand={brandName}
                data-url={p.url}
              >
                <svg class="w-3.5 h-3.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
                Agregar al carrito
              </button>
              <a
                href={`https://wa.me/51934852558?text=${encodeURIComponent(`Hola MALCOS, deseo cotizar:\n• ${p.name} (${brandName})`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full bg-green-500 hover:bg-green-600 text-white text-[10px] font-extrabold uppercase tracking-wide py-2 rounded-lg flex items-center justify-center gap-1.5 transition-colors"
              >
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                Cotizar ahora
              </a>
            </div>
          </div>
          );
        })}
      </div>
    ))}

    <!-- CTA -->
    <div class="mt-12 text-center">
      <a
        href="#cotizar"
        class="inline-block bg-brand-orange text-white px-10 py-4 rounded font-extrabold text-sm uppercase tracking-widest hover:bg-orange-600 transition-colors shadow-md shadow-brand-orange/20"
      >
        Solicitar Cotización {brandName}
      </a>
    </div>
  </div>
</section>

<script>
  import { addItem } from '../scripts/cart';

  // Agregar al carrito
  document.querySelectorAll<HTMLButtonElement>('.add-to-cart').forEach(btn => {
    btn.addEventListener('click', () => {
      addItem({
        id: btn.dataset.id!,
        name: btn.dataset.name!,
        img: btn.dataset.img!,
        brand: btn.dataset.brand!,
        url: btn.dataset.url!,
      });
      // Feedback visual
      const original = btn.innerHTML;
      btn.innerHTML = '✓ Agregado';
      btn.classList.add('bg-green-600');
      btn.classList.remove('bg-brand-blue', 'hover:bg-blue-800');
      setTimeout(() => {
        btn.innerHTML = original;
        btn.classList.remove('bg-green-600');
        btn.classList.add('bg-brand-blue', 'hover:bg-blue-800');
      }, 1200);
      // Abrir drawer
      window.dispatchEvent(new CustomEvent('cart:open'));
    });
  });

  // Tabs
  document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab;
      const group = btn.dataset.group;

      document.querySelectorAll<HTMLButtonElement>(`.tab-btn[data-group="${group}"]`).forEach(t => {
        t.classList.remove('bg-brand-blue', 'text-white', 'border-brand-blue');
        t.classList.add('bg-white', 'text-slate-600', 'border-slate-200');
      });

      btn.classList.add('bg-brand-blue', 'text-white', 'border-brand-blue');
      btn.classList.remove('bg-white', 'text-slate-600', 'border-slate-200');

      document.querySelectorAll<HTMLElement>(`.product-panel[data-group="${group}"]`).forEach(panel => {
        panel.classList.toggle('hidden', panel.id !== `panel-${target}`);
      });
    });
  });
</script>
