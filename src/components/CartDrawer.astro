---
---
<!-- Overlay -->
<div id="cart-overlay" class="fixed inset-0 bg-black/50 z-[60] hidden opacity-0 transition-opacity duration-300"></div>

<!-- Drawer -->
<aside
  id="cart-drawer"
  class="fixed top-0 right-0 h-full w-full sm:w-[420px] bg-white z-[70] shadow-2xl flex flex-col translate-x-full transition-transform duration-300 ease-in-out"
  aria-label="Carrito de cotización"
>
  <!-- Header -->
  <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-brand-blue">
    <div class="flex items-center gap-3">
      <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
      </svg>
      <h2 class="text-white font-black text-sm uppercase tracking-widest">Lista de Cotización</h2>
    </div>
    <button id="cart-close" class="text-white/80 hover:text-white transition-colors" aria-label="Cerrar">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Empty state -->
  <div id="cart-empty" class="hidden flex-1 flex flex-col items-center justify-center gap-4 text-slate-400 px-8 text-center">
    <svg class="w-16 h-16 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
    </svg>
    <p class="text-sm font-semibold">Tu lista de cotización está vacía</p>
    <p class="text-xs">Agrega productos desde el catálogo</p>
  </div>

  <!-- Items list -->
  <ul id="cart-items" class="flex-1 overflow-y-auto divide-y divide-slate-100 px-4 py-2"></ul>

  <!-- Footer -->
  <div id="cart-footer" class="border-t border-slate-100 p-5 flex flex-col gap-3">
    <p class="text-xs text-slate-500 text-center">
      <span id="cart-count-label">0 productos</span> listos para cotizar
    </p>
    <textarea
      id="cart-note"
      placeholder="Mensaje adicional (opcional)..."
      rows="2"
      class="w-full text-xs border border-slate-200 rounded-lg px-3 py-2 resize-none focus:outline-none focus:border-brand-blue text-slate-700"
    ></textarea>
    <a
      id="cart-wa-btn"
      href="#"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center gap-2 bg-green-500 hover:bg-green-600 text-white font-extrabold text-sm uppercase tracking-widest py-4 rounded-lg transition-colors shadow-md"
    >
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      Enviar Cotización por WhatsApp
    </a>
    <button
      id="cart-clear"
      class="text-xs text-slate-400 hover:text-red-500 transition-colors underline underline-offset-2 text-center"
    >
      Vaciar lista
    </button>
  </div>
</aside>

<script>
  import { getCart, removeItem, clearCart, buildWhatsAppUrl, getCount } from '../scripts/cart';
  import type { CartItem } from '../scripts/cart';

  const drawer = document.getElementById('cart-drawer')!;
  const overlay = document.getElementById('cart-overlay')!;
  const closeBtn = document.getElementById('cart-close')!;
  const itemsList = document.getElementById('cart-items')!;
  const emptyEl = document.getElementById('cart-empty')!;
  const footerEl = document.getElementById('cart-footer')!;
  const waBtn = document.getElementById('cart-wa-btn') as HTMLAnchorElement;
  const clearBtn = document.getElementById('cart-clear')!;
  const noteEl = document.getElementById('cart-note') as HTMLTextAreaElement;
  const countLabel = document.getElementById('cart-count-label')!;

  function openDrawer() {
    drawer.classList.remove('translate-x-full');
    overlay.classList.remove('hidden');
    requestAnimationFrame(() => overlay.classList.remove('opacity-0'));
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    drawer.classList.add('translate-x-full');
    overlay.classList.add('opacity-0');
    setTimeout(() => overlay.classList.add('hidden'), 300);
    document.body.style.overflow = '';
  }

  function renderItem(item: CartItem): string {
    return `
      <li class="flex items-center gap-3 py-3" data-id="${item.id}">
        <img src="${item.img}" alt="${item.name}" class="w-14 h-14 object-contain rounded-lg bg-slate-50 p-1 border border-slate-100 flex-shrink-0" />
        <div class="flex-1 min-w-0">
          <p class="text-xs font-bold text-slate-800 leading-snug">${item.name}</p>
          <p class="text-[10px] text-brand-orange font-semibold uppercase mt-0.5">${item.brand}</p>
        </div>
        <button
          class="remove-item flex-shrink-0 text-slate-300 hover:text-red-500 transition-colors p-1"
          data-id="${item.id}"
          aria-label="Eliminar"
        >
          <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
        </button>
      </li>
    `;
  }

  function render() {
    const items = getCart();
    const count = items.reduce((s, i) => s + i.qty, 0);
    const isEmpty = items.length === 0;

    emptyEl.classList.toggle('hidden', !isEmpty);
    emptyEl.classList.toggle('flex', isEmpty);
    footerEl.classList.toggle('hidden', isEmpty);
    itemsList.innerHTML = isEmpty ? '' : items.map(renderItem).join('');
    countLabel.textContent = `${count} producto${count !== 1 ? 's' : ''}`;
    waBtn.href = buildWhatsAppUrl(items, noteEl.value);

    // Eventos de eliminar
    itemsList.querySelectorAll<HTMLButtonElement>('.remove-item').forEach(btn => {
      btn.addEventListener('click', () => {
        removeItem(btn.dataset.id!);
      });
    });
  }

  // Actualizar badge del navbar
  function updateBadge() {
    const count = getCount();
    document.querySelectorAll<HTMLElement>('[data-cart-badge]').forEach(el => {
      el.textContent = String(count);
      el.parentElement?.classList.toggle('hidden', count === 0);
    });
  }

  // Eventos globales
  window.addEventListener('cart:update', () => { render(); updateBadge(); });
  window.addEventListener('cart:open', () => { render(); openDrawer(); });
  closeBtn.addEventListener('click', closeDrawer);
  overlay.addEventListener('click', closeDrawer);
  clearBtn.addEventListener('click', () => clearCart());
  noteEl.addEventListener('input', () => {
    waBtn.href = buildWhatsAppUrl(getCart(), noteEl.value);
  });

  // Init
  render();
  updateBadge();
</script>
