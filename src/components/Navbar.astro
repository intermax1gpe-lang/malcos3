---
import { brands } from '../data/brands';
---
<nav class="bg-brand-blue sticky top-0 z-50 px-6 md:px-12 flex justify-between items-center shadow-md">
  <ul class="flex flex-wrap">
    <li>
      <a href="/" class="block px-4 py-4 text-white text-xs font-bold uppercase tracking-wide bg-black/20 hover:bg-black/30 transition-colors">
        Inicio
      </a>
    </li>
    {brands.map((b) => (
      <li>
        <a
          href={`#${b.slug}`}
          class="block px-4 py-4 text-white text-xs font-bold uppercase tracking-wide hover:bg-black/15 transition-colors"
        >
          {b.name}
        </a>
      </li>
    ))}
  </ul>
  <div class="flex gap-4 items-center">
    <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="hidden sm:block text-white text-xs font-bold opacity-80 hover:opacity-100 transition-opacity uppercase tracking-wider">
      Facebook
    </a>
    <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="hidden sm:block text-white text-xs font-bold opacity-80 hover:opacity-100 transition-opacity uppercase tracking-wider">
      Instagram
    </a>
    <!-- Botón carrito -->
    <button
      id="navbar-cart-btn"
      aria-label="Ver cotización"
      class="relative flex items-center gap-2 bg-brand-orange hover:bg-orange-500 transition-colors text-white text-xs font-extrabold uppercase tracking-wide px-3 py-2 rounded-lg"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
      </svg>
      <span class="hidden sm:inline">Cotizar</span>
      <span class="hidden">
        <span data-cart-badge class="bg-white text-brand-orange text-[10px] font-black rounded-full w-4 h-4 flex items-center justify-center">0</span>
      </span>
    </button>
  </div>

  <script>
    document.getElementById('navbar-cart-btn')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('cart:open'));
    });
  </script>
</nav>
