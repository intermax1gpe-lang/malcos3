---
import { brands } from '../data/brands';
---
<nav class="bg-brand-blue sticky top-0 z-50 shadow-md flex items-center">
  <ul class="flex w-full sm:flex-1 sm:min-w-0">
    <li class="flex-1 min-w-0 sm:flex-none sm:shrink-0">
      <a href="/" class="flex items-center justify-center text-center px-1 sm:px-4 py-4 text-white text-[10px] sm:text-xs font-bold uppercase tracking-wide bg-black/20 hover:bg-black/30 transition-colors whitespace-nowrap">
        Inicio
      </a>
    </li>
    {brands.map((b) => (
      <li class="flex-1 min-w-0 sm:flex-none sm:shrink-0">
        <a
          href={`/marca/${b.slug}`}
          class="flex items-center justify-center text-center px-1 sm:px-4 py-4 text-white text-[10px] sm:text-xs font-bold uppercase tracking-wide hover:bg-black/15 transition-colors whitespace-nowrap"
        >
          {b.name}
        </a>
      </li>
    ))}
  </ul>
  <div class="hidden sm:flex items-center shrink-0 pr-3">
    <!-- Botón carrito (oculto en mobil, se muestra en el TopBar) -->
    <button
      id="navbar-cart-btn"
      aria-label="Ver cotización"
      class="cart-open-btn relative flex items-center gap-2 bg-brand-orange hover:bg-orange-500 transition-colors text-white text-xs font-extrabold uppercase tracking-wide px-3 py-2 rounded-lg"
    >
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
      </svg>
      <span class="hidden sm:inline">Cotizar</span>
      <span data-cart-badge-wrap class="hidden absolute -top-1.5 -right-1.5">
        <span data-cart-badge class="bg-white text-brand-orange text-[10px] font-black rounded-full w-4 h-4 flex items-center justify-center">0</span>
      </span>
    </button>
  </div>

  <script>
    document.querySelectorAll('.cart-open-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('cart:open'));
      });
    });

    function updateBadge() {
      try {
        const cart = JSON.parse(localStorage.getItem('malcos_cart') ?? '[]');
        const count = cart.reduce((s: number, i: { qty: number }) => s + i.qty, 0);
        document.querySelectorAll('[data-cart-badge]').forEach(badge => {
          badge.textContent = String(count);
        });
        document.querySelectorAll('[data-cart-badge-wrap]').forEach(wrap => {
          wrap.classList.toggle('hidden', count === 0);
        });
      } catch {}
    }

    updateBadge();
    window.addEventListener('cart:update', updateBadge);
  </script>
</nav>
