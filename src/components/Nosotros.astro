---
import { brands } from '../data/brands';
---
<section class="grid grid-cols-1 lg:grid-cols-2" style="min-height: 100vh;">
  <!-- Foto izquierda -->
  <div
    class="hidden lg:block bg-cover bg-center"
    style="background-image: url('/images/hero-bg.jpg');"
    aria-hidden="true"
  ></div>

  <!-- Texto derecho -->
  <div class="flex flex-col justify-center px-6 md:px-16 lg:px-20 py-16 md:py-24 bg-white">
    <span class="text-brand-orange text-xs font-extrabold uppercase tracking-widest mb-4">
      Quiénes somos
    </span>
    <h2 class="text-3xl md:text-4xl font-black text-slate-900 mb-6 leading-tight uppercase">
      Nosotros
    </h2>
    <p class="text-sm md:text-base text-slate-600 leading-relaxed mb-6">
      Somos una Empresa peruana dedicada a la Importación e Distribución de
      <strong>INTERCOMUNICADORES, VIDEO PORTEROS, SISTEMAS DIGITALES Y ANÁLOGAS</strong>,
      Cerraduras Eléctricas y Accesorios.
    </p>
    <p class="text-sm md:text-base text-slate-600 leading-relaxed mb-6">
      Para Casa, Oficina, Edificio, Condominio, Hoteles.
      Trabajamos con <strong>MARCAS LÍDERES A NIVEL MUNDIAL</strong> en sistemas de intercomunicación.
    </p>
    <ul class="mb-8 divide-y divide-slate-100 border-t border-b border-slate-100">
      {brands.map((b) => (
        <li class="flex items-center gap-3 py-3 text-sm font-bold text-slate-800">
          <span class="w-2.5 h-2.5 rounded-full bg-brand-orange flex-shrink-0"></span>
          {b.name}
        </li>
      ))}
    </ul>
    <a
      href="#cotizar"
      class="inline-block self-start bg-brand-orange text-white px-8 py-3.5 rounded font-extrabold text-xs uppercase tracking-widest hover:bg-orange-600 transition-colors shadow-md shadow-brand-orange/20"
    >
      Más información
    </a>
  </div>
</section>
