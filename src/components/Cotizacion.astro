---
import { brands } from '../data/brands';
---
<section
  id="cotizar"
  class="bg-brand-dark grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center px-6 md:px-16 lg:px-20 py-20"
  style="min-height: 100vh;"
>
  <!-- Formulario -->
  <div class="bg-[#1f1f1f]/50 p-6 md:p-10 rounded-2xl border border-white/5 w-full max-w-lg mx-auto">
    <h3 class="text-2xl md:text-3xl font-black text-white text-center mb-2 leading-tight uppercase tracking-tight">
      Solicite su Cotización
    </h3>
    <p class="text-slate-400 text-xs md:text-sm text-center mb-8 uppercase tracking-wider font-semibold">
      Personalizada y sin compromiso
    </p>

    <form id="wa-form" class="flex flex-col gap-4">
      <div>
        <label for="f-nombre" class="sr-only">Nombres y Apellidos</label>
        <input
          id="f-nombre"
          type="text"
          placeholder="Nombres y Apellidos *"
          required
          class="w-full bg-white/10 hover:bg-white/15 focus:bg-white rounded px-4 py-3.5 text-sm text-white focus:text-slate-900 placeholder-slate-400 focus:placeholder-slate-500 outline-none transition-colors border border-white/10 focus:border-white"
        />
      </div>
      <div>
        <label for="f-email" class="sr-only">Email de contacto</label>
        <input
          id="f-email"
          type="email"
          placeholder="Email de contacto (opcional)"
          class="w-full bg-white/10 hover:bg-white/15 focus:bg-white rounded px-4 py-3.5 text-sm text-white focus:text-slate-900 placeholder-slate-400 focus:placeholder-slate-500 outline-none transition-colors border border-white/10 focus:border-white"
        />
      </div>
      <div>
        <label for="f-celular" class="sr-only">Número de celular</label>
        <input
          id="f-celular"
          type="tel"
          placeholder="Celular de contacto *"
          required
          class="w-full bg-white/10 hover:bg-white/15 focus:bg-white rounded px-4 py-3.5 text-sm text-white focus:text-slate-900 placeholder-slate-400 focus:placeholder-slate-500 outline-none transition-colors border border-white/10 focus:border-white"
        />
      </div>
      <div>
        <label for="f-marca" class="sr-only">Marca de interés</label>
        <select
          id="f-marca"
          class="w-full bg-white/10 hover:bg-white/15 focus:bg-white rounded px-4 py-3.5 text-sm text-slate-300 focus:text-slate-900 outline-none transition-colors border border-white/10 focus:border-white cursor-pointer"
        >
          <option value="" class="text-slate-900">Marca de interés / Producto</option>
          {brands.map((b) => <option value={b.name} class="text-slate-900">{b.name}</option>)}
          <option value="No sé aún" class="text-slate-900">No sé aún / Otro</option>
        </select>
      </div>
      <div>
        <label for="f-mensaje" class="sr-only">Detalle de consulta</label>
        <textarea
          id="f-mensaje"
          placeholder="Detalle de consulta (Ej: tipo de inmueble, cantidad de departamentos, accesorios...)"
          rows="4"
          class="w-full bg-white/10 hover:bg-white/15 focus:bg-white rounded px-4 py-3.5 text-sm text-white focus:text-slate-900 placeholder-slate-400 focus:placeholder-slate-500 outline-none transition-colors border border-white/10 focus:border-white resize-none"
        ></textarea>
      </div>

      <button
        type="submit"
        class="w-full bg-[#25d366] text-white py-4 rounded font-black text-xs uppercase tracking-widest flex items-center justify-center gap-3 hover:bg-[#1fba58] transition-colors cursor-pointer shadow-lg shadow-[#25d366]/20"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="white" class="flex-shrink-0">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        Enviar por WhatsApp
      </button>
      <p class="text-slate-500 text-[10px] text-center uppercase tracking-widest font-bold">
        Abrirá chat de WhatsApp con tu consulta
      </p>
    </form>

    <script>
      document.getElementById('wa-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const nombre  = (document.getElementById('f-nombre')  as HTMLInputElement).value;
        const email   = (document.getElementById('f-email')   as HTMLInputElement).value;
        const celular = (document.getElementById('f-celular') as HTMLInputElement).value;
        const marca   = (document.getElementById('f-marca')   as HTMLSelectElement).value;
        const mensaje = (document.getElementById('f-mensaje') as HTMLTextAreaElement).value;

        const text = `Hola MALCOS, me interesa una cotización.\nNombre: ${nombre}\nEmail: ${email || 'No especificado'}\nCelular: ${celular}\nMarca: ${marca || 'No especificada'}\nMensaje: ${mensaje || 'Sin detalles adicionales'}`;
        window.open(`https://wa.me/51934852558?text=${encodeURIComponent(text)}`, '_blank');
      });
    </script>
  </div>

  <!-- Texto motivacional -->
  <div class="text-center lg:text-left">
    <span class="text-brand-orange text-xs font-extrabold uppercase tracking-widest mb-4 inline-block">
      Contacto Directo
    </span>
    <h2 class="text-3xl md:text-5xl font-black text-white leading-tight uppercase mb-6 max-w-lg">
      ¿Buscas asesoría experta?
    </h2>
    <p class="text-slate-400 text-base md:text-lg leading-relaxed max-w-md">
      Estamos listos y dispuestos a brindarle nuestra experta asistencia en su proyecto.
      Atendemos Lima Metropolitana y Callao.
    </p>
  </div>
</section>
